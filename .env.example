# PHYTOsense environment configuration.
# Copy to .env and adjust. All values optional — defaults are built in.

# ---------------------------------------------------------------------------
# Database (Prisma + SQLite). PostgreSQL/PostGIS can replace this later.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./db/custom.db"

# ---------------------------------------------------------------------------
# NASA POWER Daily Point API (https://power.larc.nasa.gov/docs/services/api/temporal/daily/)
# ---------------------------------------------------------------------------
# Base endpoint — override ONLY for network-failure testing (see TESTING.md §C).
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/daily/point"
# Data community: AG = agroclimatology (used by this project).
NASA_POWER_COMMUNITY="AG"
# Time standard for returned observations.
NASA_POWER_TIME_STANDARD="UTC"
# Per-request timeout (ms).
NASA_POWER_TIMEOUT_MS=20000
# Retries after the first attempt (exponential backoff: base × 2^attempt).
NASA_POWER_MAX_RETRIES=2
NASA_POWER_BACKOFF_BASE_MS=1500

# ---------------------------------------------------------------------------
# Default farm location (Al Ain case study — replace with real farm coordinates
# in the Farm Profile screen for actual decision support).
# ---------------------------------------------------------------------------
DEFAULT_FARM_LAT=24.2075
DEFAULT_FARM_LON=55.7447
DEFAULT_FARM_LABEL="Al Ain, Abu Dhabi, UAE"

# ---------------------------------------------------------------------------
# Cache & connectivity policy
# ---------------------------------------------------------------------------
# Days counted as "recent" (may be revised by NASA; refreshed only on explicit request).
CACHE_RECENT_WINDOW_DAYS=7
# In-memory TTL (ms) for connectivity probe results (protects NASA endpoints).
CONNECTIVITY_CHECK_TTL_MS=60000

# Shared secret for ESP32 sensor ingestion (POST /api/fieldsense/ingest, header X-Device-Key).
# Leave unset to disable ingestion entirely (the endpoint then refuses ALL writes with 503).
# Set it ONLY when you actually connect a device. NEVER commit the real value.
# PHYTOSENSE_DEVICE_KEY=change-me-local-device-key
